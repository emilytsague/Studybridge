PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Beim Veröffentlichen die HTTPS-Adresse ohne abschließenden Schrägstrich eintragen.
PUBLIC_ORIGIN=http://localhost:3000
# Nur bei Betrieb über HTTPS auf true setzen.
COOKIE_SECURE=false
# Optionaler Einladungscode für neue Konten.
REGISTRATION_CODE=
# Optionale KI-Konfiguration. Die echte .env-Datei gehört nicht in Git.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_REQUESTS_PER_HOUR=20
