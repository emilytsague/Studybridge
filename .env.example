PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Set to the public HTTPS origin when deploying; no trailing slash.
PUBLIC_ORIGIN=http://localhost:3000
# Set true only behind HTTPS.
COOKIE_SECURE=false
# Optional: require this invitation code for new accounts.
REGISTRATION_CODE=
# Optional AI configuration. Never commit the real .env file.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_REQUESTS_PER_HOUR=20
